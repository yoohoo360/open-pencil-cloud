{
  "name": "@open-pencil/desktop-electron",
  "productName": "OpenPencil",
  "version": "0.15.1",
  "private": true,
  "description": "OpenPencil Electron desktop shell",
  "author": "OpenPencil",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "ensure:mcp-binary": "bun ./scripts/ensure-mcp-binary.ts",
    "build:main": "bun ./scripts/build-main.ts",
    "build": "OPENPENCIL_APP_ENV=prod bun ./scripts/build.ts",
    "build:local": "OPENPENCIL_APP_ENV=local bun ./scripts/build.ts",
    "build:dev": "OPENPENCIL_APP_ENV=dev bun ./scripts/build.ts",
    "build:prod": "OPENPENCIL_APP_ENV=prod bun ./scripts/build.ts",
    "build:dir": "OPENPENCIL_APP_ENV=prod bun ./scripts/build.ts --dir",
    "build:dir:local": "OPENPENCIL_APP_ENV=local bun ./scripts/build.ts --dir",
    "build:dir:dev": "OPENPENCIL_APP_ENV=dev bun ./scripts/build.ts --dir",
    "dev": "OPENPENCIL_APP_ENV=local bun ./scripts/dev.ts",
    "dev:local": "OPENPENCIL_APP_ENV=local bun ./scripts/dev.ts",
    "dev:dev": "OPENPENCIL_APP_ENV=dev bun ./scripts/dev.ts",
    "start": "OPENPENCIL_APP_ENV=local bun run build:main && OPENPENCIL_APP_ENV=local electron .",
    "start:frontend": "bun --cwd ../packages/react run start",
    "start:mcp": "bun ./scripts/start-mcp.ts",
    "start:agent-server": "bun --cwd ../desktop-react run start:agent-server",
    "start:services": "bun ./scripts/start-services.ts"
  },
  "dependencies": {
    "@open-pencil/fig": "workspace:*"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
