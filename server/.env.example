# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/jongwong
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=jongwong-secret-key-change-in-production-minimum-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Application Configuration
APP_NAME=HaloLight
PORT=8000
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:8080
PUBLIC_URL=http://localhost:8000

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:8000/api/oauth/github
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/api/oauth/google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# SMTP (leave MAIL_HOST empty to log verification codes in the API console)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Storage: local / oss
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# Aliyun OSS (used when STORAGE_TYPE=oss)
# Console: https://oss.console.aliyun.com
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_BASE_PATH=files/
OSS_PRESIGN_EXPIRATION_SECONDS=900
BLANK_FIG_URL=https://yoohoo-oss.oss-cn-shanghai.aliyuncs.com/pencil/blank.fig


# Logging
LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=DEBUG
SHOW_SQL=true

# Rate limiting is off on local/dev profiles. Set true only if you need to test it.
# RATE_LIMIT_ENABLED=false

