{
  "name": "@open-pencil/react",
  "version": "0.14.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite --config ./vite.config.ts --port 8080 --strictPort",
    "start": "cross-env NODE_ENV=development APP_ENV=dev rspack server",
    "build": "vite build && bun run build:dts",
    "build:test": "cross-env NODE_ENV=production APP_ENV=test rspack --mode production ",
    "build:prod": "cross-env NODE_ENV=production APP_ENV=prod rspack --mode production ",
    "build:dts": "bunx tsc --emitDeclarationOnly -p tsconfig.build.json",
    "check": "bun run typecheck && bun run build && bun run smoke:dist",
    "prepack": "bun run build",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@nanostores/i18n": "^1.3.3",
    "@nanostores/react": "^1.0.0",
    "@open-pencil/dom-css": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@rspack/cli": "^2.2.2",
    "@rspack/core": "^2.2.2",
    "@rspack/dev-server": "^2.2.1",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "axios": "^1.19.0",
    "cross-env": "^10.1.0",
    "es-toolkit": "^1.51.0",
    "js-cookie": "^3.0.8",
    "lib0": "^0.2.117",
    "lucide-react": "^0.525.0",
    "nanostores": "^1.5.0",
    "react-resizable-panels": "^3.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tinykeys": "^3.1.0",
    "uuid": "^14.0.2",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-refresh": "^0.18.0",
    "react-router-dom": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "vite": "8.1.4",
    "workbox-build": "^7.4.1"
  },
  "peerDependencies": {
    "@open-pencil/core": "workspace:*",
    "canvaskit-wasm": ">=0.41.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "canvaskit-wasm": {
      "optional": true
    }
  }
}
