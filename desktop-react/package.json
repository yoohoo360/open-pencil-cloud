    "start:agent-server": "bun ./scripts/start-agent-server.ts",
    "start:services": "bun ./scripts/start-services.ts",
    "test:agent-server": "bun test ./agent-server/tests"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/langgraph-cli": "^1.5.2",
    "@langchain/openai": "^1.2.0",
    "fflate": "^0.8.3",
    "langchain": "^1.2.3",
    "zod": "^4.3.6"
  }
}
