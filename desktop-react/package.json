{
  "name": "@open-pencil/desktop-react",
  "private": true,
  "type": "module",
  "exports": {
    "./agent-server/spawn": "./agent-server/src/spawn.ts",
    "./agent-server/workdir": "./agent-server/src/workdir/http.ts"
  },
  "scripts": {
    "generate:menu": "bun ../packages/react/scripts/generate-desktop-menu.ts",
    "ensure:mcp-binary": "bun ./scripts/ensure-mcp-binary.ts",
